{% macro prise(p) %}
    <li>
        {% if p.record %}
            <strong>{{ p.espece|upper }} — RECORD</strong>
        {% else %}
            {{ p.espece }}
        {% endif %}
        — {{ p.poids|poids }}
        <em>({{ categorie_prise(p.poids) }})</em>
        à {{ p.spot.nom }}
        le {{ p.date|date('d/m/Y') }}

        <a href="{{ path('app_prise_modifier', {id: p.id}) }}">Modifier</a>

        <form method="post"
              action="{{ path('app_prise_supprimer', {id: p.id}) }}"
              onsubmit="return confirm('Supprimer définitivement cette prise ?');"
              style="display: inline;">
            <button type="submit">Supprimer</button>
        </form>
    </li>
{% endmacro %}

{% macro alerte(message, type = 'info') %}
    <div class="alerte alerte-{{ type }}">
        <strong>{{ type|upper }}</strong> — {{ message }}
    </div>
{% endmacro %}
